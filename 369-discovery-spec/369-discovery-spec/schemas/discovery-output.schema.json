{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://369degrees.ai/schemas/discovery-output.schema.json",
  "title": "369 Degrees Discovery Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "status",
    "user_profile",
    "opportunities",
    "blueprint"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "completed",
        "needs_clarification"
      ]
    },
    "user_profile": {
      "$ref": "user-profile.schema.json"
    },
    "opportunities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "radar",
        "unexpected"
      ],
      "properties": {
        "primary": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "opportunity.schema.json"
          }
        },
        "radar": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "$ref": "opportunity.schema.json"
          }
        },
        "unexpected": {
          "$ref": "opportunity.schema.json"
        }
      }
    },
    "blueprint": {
      "$ref": "blueprint.schema.json"
    },
    "next_action": {
      "type": "string"
    },
    "follow_up": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "needed": {
          "type": "boolean"
        },
        "question": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
