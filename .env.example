# 369 Degrees — CLIENT environment (Vite). PUBLIC values only.
# These are compiled into the browser bundle. NEVER put secrets here.
# Copy to .env for local dev, and set the same keys in Netlify env settings.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-PUBLIC-KEY
VITE_APP_URL=https://your-deployed-site.example

# Whop checkout is started server-side (supabase/functions/whop-checkout) and
# needs no client env var — see that function's and supabase/.env.example's secrets.
