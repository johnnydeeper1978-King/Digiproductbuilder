{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://369degrees.co.za/schemas/opportunity.schema.json",
  "title": "Product Opportunity",
  "description": "A digital product opportunity generated by 369 Degrees Discovery.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "productFormat": {
      "type": "string",
      "description": "Digital product format.",
      "enum": [
        "ebook",
        "guide",
        "template",
        "spreadsheet",
        "checklist",
        "prompt-pack",
        "notion-system",
        "course",
        "workshop",
        "toolkit",
        "swipe-file",
        "calculator",
        "planner",
        "database",
        "membership",
        "other"
      ]
    },
    "evidenceType": {
      "type": "string",
      "description": "Distinguishes user-fit reasoning, hypotheses, and research-backed evidence.",
      "enum": ["user-fit", "hypothesis", "research-backed"]
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable identifier used to reference this opportunity (e.g. as the selected opportunity)."
    },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "targetBuyer": {
      "type": "string",
      "description": "Who buys this."
    },
    "problem": {
      "type": "string",
      "description": "The problem this opportunity solves."
    },
    "outcome": {
      "type": "string",
      "description": "What changes for the buyer."
    },
    "productFormat": { "$ref": "#/$defs/productFormat" },
    "score": {
      "type": "object",
      "description": "Opportunity score from the product scoring framework.",
      "additionalProperties": false,
      "properties": {
        "overall": { "type": "number", "minimum": 0, "maximum": 100 },
        "breakdown": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "userFit": { "type": "number", "minimum": 0, "maximum": 100 },
            "problemClarity": { "type": "number", "minimum": 0, "maximum": 100 },
            "buyerClarity": { "type": "number", "minimum": 0, "maximum": 100 },
            "feasibility": { "type": "number", "minimum": 0, "maximum": 100 },
            "differentiation": { "type": "number", "minimum": 0, "maximum": 100 },
            "demandSignals": { "type": "number", "minimum": 0, "maximum": 100 },
            "distributionPotential": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      },
      "required": ["overall"]
    },
    "reasoning": {
      "type": "string",
      "description": "Why this opportunity fits the user."
    },
    "isUnexpected": {
      "type": "boolean",
      "description": "True for adjacent / spinoff opportunities the user may not have considered.",
      "default": false
    },
    "evidence": {
      "type": "array",
      "description": "Supporting statements, each labelled by type. Never present a hypothesis as fact.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "$ref": "#/$defs/evidenceType" },
          "statement": { "type": "string" },
          "source": { "type": "string" }
        },
        "required": ["type", "statement"]
      }
    }
  },
  "required": ["name", "targetBuyer", "problem", "outcome", "productFormat"]
}
