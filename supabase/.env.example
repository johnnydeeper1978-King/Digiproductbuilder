# 369 Degrees — SERVER secrets for Supabase Edge Functions.
# These are set with `supabase secrets set KEY=value` (or a dashboard), NEVER in the repo
# and NEVER in client code.
#
# Supabase INJECTS these automatically into Edge Functions — you do NOT set them:
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#
# You DO set the following:

# --- AI (at least one; resolver order: anthropic > openai > perplexity) ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# PERPLEXITY_API_KEY=

# --- Whop ---
WHOP_WEBHOOK_SECRET=          # from the webhook endpoint you register in the Whop dashboard
WHOP_BUILDER_PLAN_ID=         # the Whop plan id for the $97 one-time Builder product
WHOP_DMOS_PLAN_ID=            # the Whop plan id for Digital Marketing OS, once that product exists

# --- App ---
APP_URL=                      # your deployed site URL
