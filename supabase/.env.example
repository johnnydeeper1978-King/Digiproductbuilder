# 369 Degrees — SERVER secrets for Supabase Edge Functions.
# These are set with `supabase secrets set KEY=value` (or a dashboard), NEVER in the repo
# and NEVER in client code.
#
# Supabase INJECTS these automatically into Edge Functions — you do NOT set them:
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#
# You DO set the following:

# --- AI (at least one; resolver order: anthropic > openai > perplexity) ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# PERPLEXITY_API_KEY=

# --- Whop ---
# Products beyond the Builder (Digital Marketing OS, etc.) need NO new secret here —
# whop-checkout resolves their buy-now plan live from catalog_products.whop_product_id.
WHOP_API_KEY=                 # Whop API key (server-only). Falls back to a secret
                               # literally named "369 Supabase production" if unset — rename it to this.
WHOP_WEBHOOK_SECRET=          # from the webhook endpoint you register in the Whop dashboard
WHOP_COMPANY_ID=              # optional override; defaults to biz_5LxzQhYQsk1Wbw
WHOP_BUILDER_PRODUCT_ID=      # optional override; defaults to prod_UywgvuejgK9Nx
WHOP_BUILDER_PLAN_ID=         # optional: pin the Builder's plan id instead of resolving it live

# --- App ---
APP_URL=                      # your deployed site URL — used for post-checkout redirects
